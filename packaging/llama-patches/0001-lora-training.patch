+    if (c >= k) {
+        return;
+    }
+    const int64_t col = cols[c];
+    for (int64_t r = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; r < n_rows; r += (int64_t) gridDim.x*blockDim.x) {
+        dst[r + c*n_rows] = src[r + col*n_rows];
+    }
+}
+
+static __global__ void k_out_prod_id_scatter(const float * d, const int32_t * cols, float * dst,
+        const int64_t n_in, const int64_t k, const int64_t n_used, const int64_t n_b1) {
+    const int64_t c = blockIdx.y;
+    if (c >= k) {
+        return;
+    }
+    const int64_t col = cols[c];
+    const int64_t s   = col % n_used;
+    const int64_t t   = col / n_used;
+    float * out = dst + ((n_b1 == 1 ? 0 : s) + t*n_b1)*n_in;
+    for (int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; i < n_in; i += (int64_t) gridDim.x*blockDim.x) {
+        atomicAdd(out + i, d[i + c*n_in]);
+    }
+}
+
+bool ggml_cuda_out_prod_id_supported(const ggml_tensor * op) {
+    const ggml_tensor * as  = op->src[0];
+    const ggml_tensor * g   = op->src[1];
+    const ggml_tensor * ids = op->src[2];
+    return op->type == GGML_TYPE_F32 && g->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 &&
+        ggml_is_contiguous(op) && ggml_is_contiguous(g) && ggml_is_contiguous(as) &&
+        (as->type == GGML_TYPE_F32 || ggml_get_to_fp32_cuda(as->type) != nullptr);
+}
+
+void ggml_cuda_out_prod_id(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * as  = dst->src[0];
+    const ggml_tensor * g   = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+    GGML_ASSERT(ggml_cuda_out_prod_id_supported(dst));
+
+    const int64_t n_in     = as->ne[0];
+    const int64_t n_out    = as->ne[1];
+    const int64_t n_expert = as->ne[2];
+    const int64_t n_used   = g->ne[1];
+    const int64_t n_tokens = g->ne[2];
+    const int64_t n_b1     = dst->ne[1];
+
+    cudaStream_t   stream = ctx.stream();
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, stream));
+
+    // the routing, on the host
+    std::vector<char> ids_host(ggml_nbytes(ids));
+    CUDA_CHECK(cudaMemcpyAsync(ids_host.data(), ids->data, ggml_nbytes(ids), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    std::vector<std::vector<int32_t>> cols(n_expert);
+    size_t max_k = 0;
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t s = 0; s < n_used; ++s) {
+            const int32_t e = *(const int32_t *) (ids_host.data() + s*ids->nb[0] + t*ids->nb[1]);
+            if (e >= 0 && e < n_expert) {
+                cols[e].push_back((int32_t) (s + t*n_used));
+                max_k = std::max(max_k, cols[e].size());
+            }
+        }
+    }
+
+    CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), stream));
+    if (max_k == 0) {
+        return;
+    }
+
+    const to_fp32_cuda_t to_fp32 = as->type == GGML_TYPE_F32 ? nullptr : ggml_get_to_fp32_cuda(as->type);
+    const int64_t rows_per_slice = std::max<int64_t>(1, (int64_t(64) << 20) / n_in);
+
+    ggml_cuda_pool_alloc<int32_t> cols_d(ctx.pool(), max_k);
+    ggml_cuda_pool_alloc<float>   g_e   (ctx.pool(), n_out*max_k);
+    ggml_cuda_pool_alloc<float>   d_e   (ctx.pool(), n_in*max_k);
+    ggml_cuda_pool_alloc<float>   slice (ctx.pool(), to_fp32 ? std::min(rows_per_slice, n_out)*n_in : 1);
+
+    const float alpha = 1.0f;
+    const int block = 256;
+    for (int64_t e = 0; e < n_expert; ++e) {
+        const int64_t k_all = (int64_t) cols[e].size();
+        // gridDim.y is at most 65535 columns per launch
+        for (int64_t c0 = 0; c0 < k_all; c0 += 65535) {
+            const int64_t k = std::min<int64_t>(65535, k_all - c0);
+            CUDA_CHECK(cudaMemcpyAsync(cols_d.get(), cols[e].data() + c0, k*sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+            {
+                const dim3 grid((unsigned) std::min<int64_t>((n_out + block - 1)/block, 64), (unsigned) k);
+                k_out_prod_id_gather<<<grid, block, 0, stream>>>((const float *) g->data, cols_d.get(), g_e.get(), n_out, k);
+                CUDA_CHECK(cudaGetLastError());
+            }
+            const char * as_e = (const char *) as->data + e*as->nb[2];
+            for (int64_t r0 = 0; r0 < n_out; r0 += rows_per_slice) {
+                const int64_t nr = std::min(rows_per_slice, n_out - r0);
+                const float * a = (const float *) (as_e + r0*as->nb[1]);
+                if (to_fp32) {
+                    to_fp32(as_e + r0*as->nb[1], slice.get(), nr*n_in, stream);
+                    a = slice.get();
+                }
+                const float beta = r0 == 0 ? 0.0f : 1.0f;
+                // d_e[n_in, k] (+)= a[n_in, nr] * g_e[r0:r0+nr, k]
+                CUBLAS_CHECK(cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N,
+                        n_in, k, nr,
+                        &alpha, a, n_in,
+                                g_e.get() + r0, n_out,
+                        &beta,  d_e.get(), n_in));
+            }
+            {
+                const dim3 grid((unsigned) std::min<int64_t>((n_in + block - 1)/block, 64), (unsigned) k);
+                k_out_prod_id_scatter<<<grid, block, 0, stream>>>(d_e.get(), cols_d.get(), (float *) dst->data, n_in, k, n_used, n_b1);
+                CUDA_CHECK(cudaGetLastError());
+            }
+        }
+    }
+}
