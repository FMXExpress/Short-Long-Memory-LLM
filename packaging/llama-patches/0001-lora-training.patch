+// memagent: LoRA training on packed windows
+
+static ggml_opt_optimizer_params lora_train_pars(void * userdata) {
+    auto & s = *(llama_context::lora_train_schedule *) userdata;
+    // linear warmup over the first steps, then linear decay to zero (as trainer/consolidate.py)
+    const double warm  = std::min(1.0, (double) (s.step + 1) / (double) std::max<int64_t>(1, s.warmup));
+    const double decay = std::max(0.0, 1.0 - (double) s.step / (double) std::max<int64_t>(1, s.total));
+    s.step++;
+    ggml_opt_optimizer_params p = ggml_opt_get_default_optimizer_params(nullptr);
+    // ggml asserts alpha > 0; a later epoch can pack into more windows than the step budget counted
+    p.adamw.alpha = (float) std::max(1e-9, s.lr * warm * decay);
+    p.adamw.wd    = s.wd;
+    p.sgd.alpha   = p.adamw.alpha;
+    p.sgd.wd      = s.wd;
+    return p;
+}
+
+static bool lora_train_reject_all(const ggml_tensor *, void *) {
+    return false; // the base model stays frozen; only the attached LoRA trains
+}
+
+int32_t llama_context::lora_train_epoch(const llama_token * tokens, const llama_token * labels, const int32_t * seqs,
+        int64_t n_windows, bool train, double * out_loss) {
+    if (!opt_ctx || n_windows <= 0) {
+        return -1;
+    }
+    const uint32_t n_ctx   = this->n_ctx();
+    const uint32_t n_batch = std::min(cparams.n_batch, n_ctx);
+
+    struct llama_batch batch = llama_batch_init(n_batch, 0, 1);
+    std::vector<llama_token> tok(n_ctx), lab(n_ctx);
+    std::vector<int32_t>     seq(n_ctx);
+    ggml_opt_result_t result = ggml_opt_result_init();
+    int64_t n_trained = 0;
+    const int64_t t_start = ggml_time_us();
+    for (int64_t w = 0; w < n_windows; ++w) {
+        std::copy(tokens + w*n_ctx, tokens + (w + 1)*n_ctx, tok.begin());
+        std::copy(labels + w*n_ctx, labels + (w + 1)*n_ctx, lab.begin());
+        std::copy(seqs   + w*n_ctx, seqs   + (w + 1)*n_ctx, seq.begin());
+        for (llama_token l : lab) {
+            n_trained += l >= 0;
+        }
+        opt_epoch_iter(nullptr, result, tok, lab, batch, nullptr, train, w, n_windows, t_start, &seq);
+    }
+    double loss = 0.0, unc = 0.0;
+    ggml_opt_result_loss(result, &loss, &unc);
+    ggml_opt_result_free(result);
+    llama_batch_free(batch);
+    // the cross-entropy is a mean over every row of a window, masked rows included:
+    // rescale to the mean over the trained tokens
+    if (out_loss) {
+        *out_loss = n_trained > 0 ? loss * (double) n_windows * n_ctx / (double) n_trained : 0.0;
+    }
+    return 0;
+}
+
+int32_t llama_lora_train_init(llama_context * ctx, llama_model * model, float lr, float weight_decay,
+        int64_t total_steps, int64_t warmup_steps) {
+    return llama_lora_train_init_adapter(ctx, model, nullptr, lr, weight_decay, total_steps, warmup_steps);
+}
+
+int32_t llama_lora_train_init_adapter(llama_context * ctx, llama_model * model, llama_adapter_lora * adapter,
+        float lr, float weight_decay, int64_t total_steps, int64_t warmup_steps) {
+    ctx->lora_sched.target = adapter;
+    ctx->lora_sched.lr     = lr;
+    ctx->lora_sched.wd     = weight_decay;
+    ctx->lora_sched.total  = total_steps;
+    ctx->lora_sched.warmup = warmup_steps;
+    ctx->lora_sched.step   = 0;
+    ctx->lora_sched.clip   = 1.0f; // clip_grad_norm_(params, 1.0), as trainer/consolidate.py
+    llama_opt_params p = {
+        /*n_ctx_train     =*/ 0,
+        /*param_filter    =*/ lora_train_reject_all,
+        /*param_filter_ud =*/ nullptr,
+        /*get_opt_pars    =*/ lora_train_pars,
+        /*get_opt_pars_ud =*/ &ctx->lora_sched,
+        /*optimizer_type  =*/ GGML_OPT_OPTIMIZER_TYPE_ADAMW,
+    };
+    try {
+        ctx->opt_init(model, p);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+    return 0;
+}
+
+int32_t llama_lora_train_epoch(llama_context * ctx, const llama_token * tokens, const llama_token * labels,
+        const int32_t * seqs, int64_t n_windows, bool train, double * out_loss) {
+    try {
+        return ctx->lora_train_epoch(tokens, labels, seqs, n_windows, train, out_loss);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return -1;
+    }
+}
+
+int32_t llama_model_convert_f32(const char * fname_inp, const char * fname_out, int32_t nthread) {
+    llama_model_quantize_params p = llama_model_quantize_default_params();
+    p.ftype   = LLAMA_FTYPE_ALL_F32;
+    p.nthread = nthread;
+    p.allow_requantize = true;   // a q8_0 base (the small profile's download) dequantizes to f32
+    return (int32_t) llama_model_quantize(fname_inp, fname_out, &p);
+}
