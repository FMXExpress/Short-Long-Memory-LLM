+
+//
+// memagent: LoRA training (create a fresh adapter, save a trained one)
+//
+
+llama_adapter_lora * llama_adapter_lora_init_new(llama_model * model, int32_t rank, float alpha, const char * targets, uint32_t seed) {
+    if (rank <= 0 || targets == nullptr) {
+        LLAMA_LOG_ERROR("%s: invalid rank or targets\n", __func__);
+        return nullptr;
+    }
+    std::vector<std::string> tgt;
+    {
+        std::stringstream ss(targets);
+        std::string item;
+        while (std::getline(ss, item, ',')) {
+            if (!item.empty()) {
+                tgt.push_back("." + item + ".weight");
+            }
+        }
+    }
+
+    auto * adapter = new llama_adapter_lora(model);
+    adapter->alpha = alpha;
+
+    // the base weights a LoRA pair is created for: 2D blk.N.<target>.weight tensors
+    std::vector<std::pair<std::string, const ggml_tensor *>> picked;
+    for (const auto & it : model->tensors_by_name) {
+        const std::string & name = it.first;
+        const ggml_tensor * w = it.second;
+        if (name.rfind("blk.", 0) != 0 || ggml_n_dims(w) != 2) {
+            continue;
+        }
+        for (const auto & t : tgt) {
+            if (name.size() >= t.size() && name.compare(name.size() - t.size(), t.size(), t) == 0) {
+                picked.emplace_back(name, w);
+                break;
+            }
+        }
+    }
+    if (picked.empty()) {
+        LLAMA_LOG_ERROR("%s: no base weights match '%s'\n", __func__, targets);
+        delete adapter;
+        return nullptr;
+    }
+
+    // trainable tensors live in a host buffer (the CPU training path)
+    auto * cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    ggml_init_params params = {
+        /*.mem_size   =*/ 2 * picked.size() * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * ctx = ggml_init(params);
+    adapter->ctxs.emplace_back(ctx);
+    for (const auto & p : picked) {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, p.second->ne[0], rank);
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, rank, p.second->ne[1]);
+        ggml_set_name(a, (p.first + ".lora_a").c_str());
+        ggml_set_name(b, (p.first + ".lora_b").c_str());
+        adapter->ab_map[p.first] = llama_adapter_lora_weight(a, b);
+    }
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(cpu_dev)) };
+    if (!buf) {
+        LLAMA_LOG_ERROR("%s: failed to allocate the adapter\n", __func__);
+        delete adapter;
+        return nullptr;
+    }
+    adapter->bufs.emplace_back(std::move(buf));
+
+    // PEFT's initialisation: A ~ U(-1/sqrt(in), 1/sqrt(in)) (kaiming_uniform, a = sqrt(5)), B = 0,
+    // so the fresh adapter changes nothing until it is trained
+    std::mt19937 rng(seed);
+    std::vector<float> data;
+    for (auto & it : adapter->ab_map) {
+        ggml_tensor * a = it.second.a;
+        const float bound = 1.0f / std::sqrt((float) a->ne[0]);
+        std::uniform_real_distribution<float> dist(-bound, bound);
+        data.resize(ggml_nelements(a));
+        for (auto & v : data) {
+            v = dist(rng);
+        }
+        ggml_backend_tensor_set(a, data.data(), 0, ggml_nbytes(a));
+        data.assign(ggml_nelements(it.second.b), 0.0f);
+        ggml_backend_tensor_set(it.second.b, data.data(), 0, ggml_nbytes(it.second.b));
+    }
+    // registered like a loaded adapter: the graph budget counts its nodes, llama_adapter_lora_free unregisters it
+    model->loras.insert(adapter);
+    LLAMA_LOG_INFO("%s: new LoRA, rank %d, alpha %.1f, %zu weights\n", __func__, rank, alpha, picked.size());
+    return adapter;
+}
+
+int32_t llama_adapter_lora_save(const llama_adapter_lora * adapter, const char * path) {
+    gguf_context * gctx = gguf_init_empty();
+    gguf_set_val_str(gctx, "general.architecture", llm_arch_name(adapter->model->arch));
+    gguf_set_val_str(gctx, "general.type", "adapter");
+    gguf_set_val_str(gctx, "adapter.type", "lora");
+    gguf_set_val_f32(gctx, "adapter.lora.alpha", adapter->alpha);
+
+    // host copies of the tensors, in a stable order
+    std::vector<std::string> names;
+    size_t bytes = 0;
+    for (const auto & it : adapter->ab_map) {
+        names.push_back(it.first);
+        bytes += ggml_nbytes(it.second.a) + ggml_nbytes(it.second.b);
+    }
+    std::sort(names.begin(), names.end());
+    ggml_init_params params = {
+        /*.mem_size   =*/ bytes + 2 * names.size() * (ggml_tensor_overhead() + GGML_MEM_ALIGN),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ false,
+    };
+    ggml_context * ctx = ggml_init(params);
+    for (const auto & name : names) {
+        const auto & w = adapter->ab_map.at(name);
+        for (ggml_tensor * src : { w.a, w.b }) {
+            ggml_tensor * t = ggml_dup_tensor(ctx, src);
+            ggml_set_name(t, src->name);
+            ggml_backend_tensor_get(src, t->data, 0, ggml_nbytes(src));
+            gguf_add_tensor(gctx, t);
+        }
+    }
+    const bool ok = gguf_write_to_file(gctx, path, false);
+    gguf_free(gctx);
+    ggml_free(ctx);
+    if (!ok) {
+        LLAMA_LOG_ERROR("%s: could not write '%s'\n", __func__, path);
+    }
+    return ok ? 0 : -1;
+}
